#version 450

layout(local_size_x = 256) in;

layout(binding = 0, std430) readonly buffer InX {
    float x[];
};

layout(binding = 1, std430) readonly buffer InW {
    float w[];
};

layout(binding = 2, std430) writeonly buffer OutY {
    float y[];
};

layout(push_constant) uniform Push {
    uint n_heads;
    uint n;
    float eps;
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= n) return;

    uint head = i / (n / n_heads);
    uint head_dim = n / n_heads;
    uint base = head * head_dim;

    float mean_sq = 0.0;
    for (uint d = 0u; d < head_dim; d++) {
        float v = x[base + d];
        mean_sq += v * v;
    }
    mean_sq /= float(head_dim);

    float rms = inversesqrt(mean_sq + eps);
    uint dim = i % head_dim;
    y[i] = x[i] * w[dim] * rms;
}
