#version 450

layout(local_size_x = 256) in;

layout(binding = 0, std430) readonly buffer InX {
    float x[];
};

layout(binding = 1, std430) readonly buffer InW {
    float w[];
};

layout(binding = 2, std430) writeonly buffer OutC {
    float c[];
};

layout(push_constant) uniform Push {
    uint m;
    uint n;
    uint k;
};

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= m) return;

    float sum = 0.0;
    for (uint j = 0u; j < k; j++) {
        sum += x[row * k + j] * w[j];
    }
    c[row] = sum;
}
