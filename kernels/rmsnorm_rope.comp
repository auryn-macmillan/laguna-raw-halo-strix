#version 450

layout(local_size_x = 256) in;

layout(binding = 0, std430) readonly buffer InX {
    float x[];
};

layout(binding = 1, std430) readonly buffer InFreq {
    float freq[];
};

layout(binding = 2, std430) writeonly buffer OutY {
    float y[];
};

layout(push_constant) uniform Push {
    uint n;
    float eps;
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= n) return;

    float mean_sq = 0.0;
    for (uint j = 0u; j < n; j++) {
        float v = x[j];
        mean_sq += v * v;
    }
    mean_sq /= float(n);

    float rms = inversesqrt(mean_sq + eps);

    uint half_dim = n / 2u;
    uint dim = i % half_dim;
    float f = freq[dim];

    if (dim < half_dim) {
        y[i] = x[i] * cos(f) - x[i + half_dim] * sin(f);
    } else {
        uint d = dim - half_dim;
        y[i] = x[i - half_dim] * sin(f) + x[i] * cos(f);
    }
}
