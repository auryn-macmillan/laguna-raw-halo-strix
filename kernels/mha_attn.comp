#version 450

layout(local_size_x = 256) in;

layout(binding = 0, std430) readonly buffer InQ {
    float Q[];
};

layout(binding = 1, std430) readonly buffer InK {
    float K[];
};

layout(binding = 2, std430) readonly buffer InV {
    float V[];
};

layout(binding = 3, std430) writeonly buffer OutAttn {
    float out_attn[];
};

layout(push_constant) uniform Push {
    uint n_q_heads;
    uint n_kv_heads;
    uint head_dim;
    uint seq_len;
    float scale;
    uint q_pos;
    uint causal;
};

void main() {
    uint d = gl_GlobalInvocationID.x;
    uint h = d / head_dim;
    uint dim = d % head_dim;
    if (h >= n_q_heads) return;

    uint kv_h = h * n_kv_heads / n_q_heads;

    uint n = seq_len;
    uint q_base = h * head_dim;

    // Online (streaming) softmax attention: single pass, no bounded scores array.
    float m = -1e30;   // running max score
    float l = 0.0;     // running sum of exp(score - m)
    float acc = 0.0;   // running weighted value accumulation

    for (uint p = 0u; p < n; p++) {
        if (causal != 0u && p > q_pos) {
            break;
        }

        uint k_base = p * n_kv_heads * head_dim + kv_h * head_dim;
        float dot = 0.0;
        for (uint j = 0u; j < head_dim; j++) {
            dot += Q[q_base + j] * K[k_base + j];
        }
        float score = dot * scale;

        float m_new = max(m, score);
        float correction = exp(m - m_new);
        float w = exp(score - m_new);

        l = l * correction + w;

        uint v_base = p * n_kv_heads * head_dim + kv_h * head_dim;
        acc = acc * correction + w * V[v_base + dim];

        m = m_new;
    }

    out_attn[d] = (l > 0.0) ? (acc / l) : 0.0;
}
