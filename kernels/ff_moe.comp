#version 450

layout(local_size_x = 256) in;

layout(binding = 0, std430) readonly buffer InGate {
    float gate[];
};

layout(binding = 1, std430) readonly buffer InUp {
    float up[];
};

layout(binding = 2, std430) readonly buffer InExpProbs {
    float exp_probs[];
};

layout(binding = 3, std430) writeonly buffer OutFF {
    float out_ff[];
};

layout(push_constant) uniform Push {
    uint n_experts;
    uint n_hidden;
    uint n_experts_used;
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= n_hidden) return;

    float sum = 0.0;
    for (uint e = 0u; e < n_experts; e++) {
        sum += gate[e] * up[e * n_hidden + i];
    }
    out_ff[i] = sum;
}
