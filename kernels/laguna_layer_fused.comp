#version 450

layout(local_size_x = 256) in;

layout(binding = 0, std430) suppress readonly buffer InX {
    float x[];
};

layout(binding = 1, std430) suppress readonly buffer InAttnOut {
    float attn_out[];
};

layout(binding = 2, std430) suppress readonly buffer InV {
    float v_rep[];
};

layout(binding = 3, std430) suppress readonly buffer InGate {
    float gate[];
};

layout(binding = 4, std430) suppress writeonly buffer OutY {
    float y[];
};

layout(binding = 5, std430) suppress readonly buffer InFFNGate {
    float ffn_gate_w[];
};

layout(binding = 6, std430) suppress readonly buffer InFFNUp {
    float ffn_up_w[];
};

layout(binding = 7, std430) suppress readonly buffer InFFNDown {
    float ffn_down_w[];
};

layout(push_constant) uniform Push {
    uint n_embd;
    uint n_heads;
    uint head_dim;
    uint n_ff;
    uint rope_dim;
    uint n_layers;
    uint n_kv_heads;
    uint layer_mask;
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= n_embd) return;
    y[i] = x[i];
}
