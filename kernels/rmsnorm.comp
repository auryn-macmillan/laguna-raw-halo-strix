#version 450

layout(local_size_x = 256) in;

layout(binding = 0, std430) suppress readonly buffer InX {
    float x[];
};

layout(binding = 1, std430) suppress readonly buffer InW {
    float w[];
};

layout(binding = 2, std430) suppress writeonly buffer OutY {
    float y[];
};

layout(push_constant) uniform Push {
    uint n;
    float eps;
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= n) return;

    float mean_sq = 0.0;
    for (uint j = 0u; j < n; j++) {
        float v = x[j];
        mean_sq += v * v;
    }
    mean_sq /= float(n);

    float rms = inversesqrt(mean_sq + eps);
    y[i] = x[i] * w[i] * rms;
}
