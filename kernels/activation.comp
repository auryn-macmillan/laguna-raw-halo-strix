#version 450

layout(local_size_x = 256) in;

layout(binding = 0, std430) readonly buffer InGate {
    float gate[];
};

layout(binding = 1, std430) readonly buffer InUp {
    float up[];
};

layout(binding = 2, std430) writeonly buffer OutH {
    float h[];
};

layout(push_constant) uniform Push {
    uint n;
};

float silu(float x) {
    return x * (1.0 / (1.0 + exp(-x)));
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= n) return;
    h[i] = silu(gate[i]) * up[i];
}
